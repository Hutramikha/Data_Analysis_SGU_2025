   "source": [
    "# Thay thế giá trị 0 ở các cột có thể bị missing bằng NaN (theo thực tế y học)\n",
    "print((df_dataset == 0).sum())\n",
    "\n",
    "cols_with_zero = ['Glucose','BloodPressure','SkinThickness','Insulin','BMI']\n",
    "df_dataset[cols_with_zero] = df_dataset[cols_with_zero].replace(0, np.nan)\n",
    "\n",
    "# Thêm cột phân loại theo độ tuổi\n",
    "df_dataset['Age_Group'] = pd.cut(df_dataset['Age'],\n",
    "                                 bins=[0, 30, 50, 100],\n",
    "                                 labels=['Young','Middle Age','Senior'])\n",
    "\n",
    "# Đổi kiểu dữ liệu của Pregnancies sang int (nếu cần)\n",
    "df_dataset['Pregnancies'] = df_dataset['Pregnancies'].astype(int)\n",
    "\n",
    "# Kiểm tra lại\n",
    "df_dataset.head()"
   ]
